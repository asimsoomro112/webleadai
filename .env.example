# Server-only Gemini key. Never prefix this value with NEXT_PUBLIC_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated list of backup Gemini API keys for auto-rotation
GEMINI_API_KEYS=""

# Firebase Admin service-account values used to verify signed-in users on API routes.
# In Vercel, add these as encrypted Production and Preview environment variables.
FIREBASE_PROJECT_ID="webleadai-a6c45"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@webleadai-a6c45.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Comma-separated emails that may call quota-consuming server APIs in production.
TEAM_ALLOWED_EMAILS="owner@example.com,teammate@example.com"

# Public deployment URL (for example https://app.example.com). Do not include a trailing slash.
APP_URL="https://app.example.com"
